# Docker Compose — copy to .env and adjust as needed.

# Database password used by both Postgres and the API connection string.
POSTGRES_PASSWORD=nabz-local-password

# Comma-separated API keys. Leave empty to disable authentication (local dev only).
NBA_API_KEYS=

# Optional: pin base images to a registry mirror.
# POSTGRES_IMAGE=registry.example.com/postgres:16-alpine
# PYTHON_IMAGE=registry.example.com/python:3.12-slim
# NODE_IMAGE=registry.example.com/node:22-alpine

# Optional: point pip at a mirror when PyPI is unreachable during build.
# PIP_INDEX_URL=https://YOUR_PYPI_MIRROR/simple
# PIP_TIMEOUT=120
# PIP_RETRIES=10
